# NOVALYN backend configuration.
# Copy to `.env` for local development. Every value here is a development
# default; none of them is a real secret. Production values are listed in
# DEPLOYMENT.md and must come from your secret manager, not from a file in git.

# development | testing | production
ENVIRONMENT=development

# --- Database -------------------------------------------------------------
# SQLite needs no setup and is fine for local development.
DATABASE_URL=sqlite:///./var/novalyn.db
# PostgreSQL (what production uses):
# DATABASE_URL=postgresql://novalyn:<password>@localhost:5432/novalyn

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left unset, a fixed development key is used; production refuses to start with it.
# SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_DAYS=7
PASSWORD_MIN_LENGTH=10

# --- Web ------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Background processing ------------------------------------------------
# With no broker, tasks run inline in the API process.
CELERY_TASK_ALWAYS_EAGER=true
# REDIS_URL=redis://localhost:6379/0

# --- Email ----------------------------------------------------------------
# file: each message is written to EMAIL_FILE_DIR as JSON (development adapter).
# console: messages are printed to the log. smtp: real delivery.
EMAIL_BACKEND=file
EMAIL_FILE_DIR=./var/mail
EMAIL_FROM=NOVALYN <no-reply@novalyn.local>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# --- File storage ---------------------------------------------------------
# local: files under STORAGE_LOCAL_DIR (development). s3: Amazon S3 or any
# S3-compatible service (MinIO, Cloudflare R2, Wasabi) via S3_ENDPOINT_URL.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/storage
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_SIZE_MB=25
# Lifetime of a file download or preview link, in seconds.
FILE_URL_TTL_SECONDS=120

# --- Documents ------------------------------------------------------------
# A document is "expiring soon" this many days before its expiry date.
EXPIRING_SOON_DAYS=30

# --- Document intelligence ------------------------------------------------
# none: no automatic reading. heuristic: rule-based development reader, no
# external calls. anthropic: Claude reads each uploaded file and suggests details.
AI_PROVIDER=heuristic
# Needed for AI_PROVIDER=anthropic (or use the SDK's own credential lookup).
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Let the API retry on another model if the first declines to read a document.
AI_REFUSAL_FALLBACK=true
AI_TIMEOUT_SECONDS=120
# auto: use Tesseract when it is installed. tesseract | none
OCR_BACKEND=auto
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Suggestions with a confidence below this are marked "needs a careful look".
EXTRACTION_CONFIDENCE_THRESHOLD=0.8

# --- Plans and billing ----------------------------------------------------
# The plan new organizations start on: free | starter | growth | business.
DEFAULT_PLAN=free
# Shown wherever a plan cannot be bought online (Business, or no payment set up).
SALES_EMAIL=sales@novalyn.example
# Online payment stays off until a provider's keys are set. Checkout then says
# plainly that payment is not set up; it never pretends a payment worked.
# Stripe (USD): secret key, webhook signing secret, and the price IDs from the
# Stripe dashboard. Webhook URL: https://<api host>/api/v1/billing/webhooks/stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER_MONTH=
# STRIPE_PRICE_STARTER_YEAR=
# STRIPE_PRICE_GROWTH_MONTH=
# STRIPE_PRICE_GROWTH_YEAR=
# Razorpay (INR): key pair, webhook secret, and the plan IDs from the Razorpay
# dashboard. Webhook URL: https://<api host>/api/v1/billing/webhooks/razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_STARTER_MONTH=
# RAZORPAY_PLAN_STARTER_YEAR=
# RAZORPAY_PLAN_GROWTH_MONTH=
# RAZORPAY_PLAN_GROWTH_YEAR=

# --- Other ----------------------------------------------------------------
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
LOG_JSON=false
